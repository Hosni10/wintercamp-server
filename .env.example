# Backend Environment Variables

# Server Configuration
# Port for the server to run on (default: 5000)
PORT=5000

# Frontend Domain URL (for CORS configuration)
# Development: http://localhost:5173
# Production: Your deployed frontend URL
DOMAIN_URL=http://localhost:5173

# Backend Server URL (for CORS configuration)
# Development: http://localhost:5000
# Production: Your deployed backend URL
SERVER_URL=http://localhost:5000

# MongoDB Connection String
# Format: mongodb://username:password@host:port/database
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/wintercamp

# Stripe Secret Key
# Get this from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# NEVER expose this in frontend code - keep it secret!
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Email Configuration (Gmail)
# Gmail account email address for sending emails
EMAIL_USER=your-email@gmail.com

# Gmail App Password
# Generate this from: https://myaccount.google.com/apppasswords
# Note: This is NOT your regular Gmail password
EMAIL_PASS=your_gmail_app_password_here
